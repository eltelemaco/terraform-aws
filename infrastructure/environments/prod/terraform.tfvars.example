# Production Tags
tags = {
  Terraform      = "true"
  Environment    = "prod"
  Project        = "terraform-aws"
  Owner          = "Platform Team"
  CostCenter     = "Engineering"
  Purpose        = "Production workloads"
  BackupPolicy   = "daily"
  SecurityLevel  = "high"
  Compliance     = "required"
}

cluster_tags = {
  GithubRepo      = "terraform-aws"
  GithubOrg       = "your-org"
  ClusterType     = "production"
  BackupPolicy    = "daily"
  MonitoringLevel = "comprehensive"
  SecurityScan    = "enabled"
}
