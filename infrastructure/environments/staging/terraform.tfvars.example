# Tags
tags = {
  Terraform   = "true"
  Environment = "staging"
  Project     = "terraform-aws"
  Owner       = "Platform Team"
  CostCenter  = "Engineering"
  Purpose     = "Pre-production testing"
}

cluster_tags = {
  GithubRepo    = "terraform-aws"
  GithubOrg     = "your-org"
  ClusterType   = "staging"
  BackupPolicy  = "daily"
}
